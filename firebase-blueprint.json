{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with authentication and study onboarding preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address."
        },
        "studyHoursPerDay": {
          "type": "number",
          "description": "Total available study hours per day (typically 1 to 14 hours)."
        },
        "peakEnergyTime": {
          "type": "string",
          "enum": ["Morning", "Afternoon", "Night"],
          "description": "User's peak cognitive energy window for high-difficulty tasks."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp."
        }
      },
      "required": ["uid", "email", "studyHoursPerDay", "peakEnergyTime"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Academic subject with target exam date and difficulty score.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique subject document ID."
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID."
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Subject title or course code."
        },
        "examDate": {
          "type": "string",
          "format": "date",
          "description": "Date of the upcoming exam (YYYY-MM-DD)."
        },
        "difficulty": {
          "type": "number",
          "description": "Subject difficulty rating from 1 (easy) to 10 (hardest)."
        },
        "priorityScore": {
          "type": "number",
          "description": "Calculated priority using (Difficulty * 10) / Days_Remaining."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        }
      },
      "required": ["id", "userId", "name", "examDate", "difficulty"]
    },
    "Task": {
      "title": "Task",
      "description": "An individual study block generated by the Python AI scheduling engine.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique task block ID."
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID."
        },
        "subjectId": {
          "type": "string",
          "description": "Associated subject document ID."
        },
        "subjectName": {
          "type": "string",
          "description": "Subject name for fast denormalized display."
        },
        "startTime": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 start timestamp for the study block."
        },
        "endTime": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 end timestamp for the study block."
        },
        "durationHours": {
          "type": "number",
          "description": "Block length in hours (1.0 to 2.0 hours)."
        },
        "date": {
          "type": "string",
          "description": "Date string (YYYY-MM-DD)."
        },
        "status": {
          "type": "string",
          "enum": ["scheduled", "completed", "missed", "rescheduled"],
          "description": "Current status of the study block."
        },
        "isPeakEnergy": {
          "type": "boolean",
          "description": "Whether this block was assigned to the user's peak energy window."
        },
        "difficulty": {
          "type": "number",
          "description": "Difficulty rating of the subject during scheduling."
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional notes or topic focus for the study block."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp."
        }
      },
      "required": ["id", "userId", "subjectId", "subjectName", "startTime", "endTime", "durationHours", "date", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user authentication identity and onboarding preferences (study hours, peak energy)."
    },
    "/subjects/{subjectId}": {
      "schema": { "$ref": "#/entities/Subject" },
      "description": "Stores user subjects with difficulty ratings (1-10) and exam deadlines."
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Stores generated 1-2 hour study blocks with real-time status (scheduled, completed, missed)."
    }
  }
}
